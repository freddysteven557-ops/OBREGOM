{
  "mcpServers": {
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-for-blender"
      ],
      "env": {
        "DISABLE_TELEMETRY": "true",
        "BLENDER_MCP_DISABLE_TELEMETRY": "true"
      }
    },
    "earshot": {
      "type": "stdio",
      "command": "/home/user/OBREGOM/.venv/bin/earshot",
      "args": [
        "mcp"
      ],
      "env": {
        "EARSHOT_THREADS": "3",
        "EARSHOT_HOME": "/home/user/OBREGOM/.earshot",
        "EARSHOT_OFFLINE": "1",
        "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1",
        "MCP_TIMEOUT": "60000",
        "HF_HUB_DISABLE_TELEMETRY": "1"
      }
    }
  }
}
